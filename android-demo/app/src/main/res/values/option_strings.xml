    <string name="option_scope_session">会话（修改后重建会话）</string>
    <string name="option_scope_load">模型加载（修改后重新加载模型）</string>
    <string name="option_use_default">使用模型默认设置</string>
    <string name="option_choice_default">模型默认（%1$s）</string>
    <string name="option_default_value">默认值：%1$s</string>
    <string name="option_value_required">必填</string>
    <string name="option_required">此项必填</string>
    <string name="option_list_unsupported">此项是列表参数，本 Demo 不支持编辑</string>
